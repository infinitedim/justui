{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "eslint": "$eslint",
    "typescript": "$typescript",
    "js-yaml": "^5.2.2",
    "nanoid": "^3.3.17",
    "next": "^16.2.11",
    "@swc/helpers": "^0.5.23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "build:showcase": "cd ../showcase && export HOME=/home/yourblooo/development/justui/.home && export PUB_CACHE=/home/yourblooo/.pub-cache && /home/yourblooo/fvm/versions/3.44.2/bin/flutter build web --wasm --release --base-href /showcase/ && rm -rf ../docs/public/showcase && cp -r build/web ../docs/public/showcase",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit",
    "clean": "rm -rf .next node_modules/.cache tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "^16.11.3",
    "fumadocs-ui": "^16.11.3",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.11",
    "@playwright/test": "^1.61.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fumadocs-mdx": "^15.1.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Edge versions",
      "last 2 Safari versions",
      "not dead"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
